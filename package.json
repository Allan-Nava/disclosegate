{
  "name": "disclosegate",
  "version": "0.0.4",
  "description": "A pre-push guard against publishing internal detail: work email addresses in commit metadata and trailers, private host, service and client names, home-directory paths and file URLs — checked before the push, because a commit on a forge stays reachable by SHA.",
  "type": "module",
  "bin": {
    "disclosegate": "bin/disclosegate.mjs"
  },
  "files": [
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node bin/disclosegate.mjs check && node --test",
    "backlog": "npx --yes backlogsync@0.1.0 check",
    "build:site": "node site/build.mjs",
    "roadmap": "npx --yes backlogsync@0.1.0 roadmap"
  },
  "backlogsync": {
    "prefix": "DG",
    "name": "disclosegate",
    "regenerate": "npm run roadmap",
    "labels": {
      "rules": [
        "4338ca",
        "The rules: email, term, path, name — what counts as a finding"
      ],
      "hook": [
        "0e8a16",
        "The pre-push hook, install and uninstall, the git protocol"
      ],
      "config": [
        "e99695",
        "User and repository config, the trust order, remotes"
      ],
      "release": [
        "5319e7",
        "Publishing and versioning"
      ],
      "docs": [
        "0075ca",
        "README, CONTRIBUTING, site"
      ],
      "project": [
        "6a737d",
        "Backlog, roadmap, repo hygiene"
      ],
      "tests": [
        "d4c5f9",
        "Test coverage and test tooling"
      ],
      "enhancement": [
        "a2eeef",
        "New capability"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allan-Nava/disclosegate.git"
  },
  "homepage": "https://allan-nava.github.io/disclosegate/",
  "bugs": "https://github.com/Allan-Nava/disclosegate/issues",
  "keywords": [
    "git",
    "pre-push",
    "hook",
    "privacy",
    "leak-prevention",
    "commit-metadata",
    "open-source-hygiene"
  ],
  "author": "Allan Nava (https://github.com/Allan-Nava)",
  "license": "MIT",
  "devDependencies": {
    "marked": "^17.0.0"
  }
}
